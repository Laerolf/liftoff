{
  "name": "@liftoff/api",
  "type": "module",
  "scripts": {
    "dev": "bun --elide-lines=0 --hot src/index.ts",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "test": "bun test --watch",
    "test:unit": "bun test --filter test/unit --watch",
    "test:integration": "bun test --filter test/integration --watch",
    "test:ci": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "start": "bun dist/index.js",
    "drizzle-kit:generate": "bun --bun drizzle-kit generate",
    "drizzle-kit:migrate": "bun --bun drizzle-kit migrate"
  },
  "dependencies": {
    "@liftoff/domain": "workspace:*",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.12.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "drizzle-kit": "^1.0.0-rc.4",
    "http-status": "catalog:",
    "typescript": "catalog:"
  }
}
