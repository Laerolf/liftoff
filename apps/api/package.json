{
  "name": "@liftoff/api",
  "version": "0.0.0",
  "description": "The Liftoff API.",
  "type": "module",
  "scripts": {
    "dev": "bun --elide-lines=0 --hot src/index.ts",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "test": "bun test --watch --only-failures",
    "test:ui": "bunx bun-test-ui",
    "test:unit": "bun test --only-failures --filter test/unit",
    "test:integration": "bun test --only-failures --filter test/integration",
    "test:ci": "bun test --only-failures",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "start": "bun dist/index.js",
    "drizzle-kit:generate": "bun --bun drizzle-kit generate",
    "drizzle-kit:migrate": "bun --bun .env.test drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@liftoff/domain": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.12",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.12.31",
    "hono-openapi": "^1.3.1",
    "zod": "catalog:",
    "zod-openapi": "^6.0.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "bun-test-ui": "catalog:",
    "drizzle-kit": "^1.0.0-rc.4",
    "http-status": "catalog:",
    "typescript": "catalog:"
  }
}
