{
  "name": "@liftoff/domain",
  "version": "0.0.1",
  "description": "The domain model of Liftoff.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "test": "bun test --watch --only-failures",
    "test:ui": "bunx bun-test-ui",
    "test:unit": "bun test --filter test/unit --only-failures",
    "test:ci": "bun test --only-failures",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "bun-test-ui": "catalog:",
    "typescript": "catalog:"
  }
}
